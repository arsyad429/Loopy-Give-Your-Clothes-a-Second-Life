# Development lokal saja. Salin ke .env dan ganti password untuk mesin Anda.
POSTGRES_DB=loopy
POSTGRES_USER=loopy
POSTGRES_PASSWORD=loopy_local_only
API_PORT=8080
# Koneksi emulator default: http://10.0.2.2:8080/
LOOPY_API_BASE_URL=http://10.0.2.2:8080/

# Groq Vision untuk API Go. Isi API key hanya di .env lokal.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RESPONSE_MODE=json_schema

# Verifikasi email saat daftar. Gunakan false hanya untuk pengujian lokal tanpa SMTP.
AUTH_EMAIL_VERIFICATION_REQUIRED=true
# Buat kunci dengan openssl rand -hex 32.
AUTH_OTP_HMAC_KEY=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_TLS_MODE=starttls
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
