# Development lokal saja. Salin ke .env dan ganti password untuk mesin Anda.
POSTGRES_DB=loopy
POSTGRES_USER=loopy
POSTGRES_PASSWORD=loopy_local_only
API_PORT=8080
# Koneksi emulator default: http://10.0.2.2:8080/
LOOPY_API_BASE_URL=http://10.0.2.2:8080/

# Compose Vision memakai proyek dan volume PostgreSQL terpisah.
VISION_API_PORT=8081
# Groq Vision untuk backend Ktor. Isi API key hanya di .env lokal.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RESPONSE_MODE=json_schema
