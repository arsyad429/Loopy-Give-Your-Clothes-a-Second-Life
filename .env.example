# Development lokal saja. Salin ke .env dan ganti password untuk mesin Anda.
POSTGRES_DB=loopy
POSTGRES_USER=loopy
POSTGRES_PASSWORD=loopy_local_only
API_PORT=8080
# Koneksi emulator default: http://10.0.2.2:8080/
LOOPY_API_BASE_URL=http://10.0.2.2:8080/
# Provider belum dipilih; kosong aman untuk template. Tidak diteruskan ke APK.
AI_VISION_API_KEY=
