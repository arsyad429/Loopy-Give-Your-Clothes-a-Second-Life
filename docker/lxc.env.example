# Copy to the repository root as .env on the LXC server.
POSTGRES_DB=loopy
POSTGRES_USER=loopy
# Required. Generate on the server: openssl rand -hex 32
POSTGRES_PASSWORD=
API_PORT=8080
# Keep loopback for a reverse proxy running directly in this LXC.
# For LAN testing / a proxy on another machine, use this LXC's LAN IPv4.
# Example: API_BIND_ADDRESS=192.168.1.50
API_BIND_ADDRESS=127.0.0.1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RESPONSE_MODE=json_schema

# Verifikasi email saat daftar. Simpan konfigurasi ini di server.
AUTH_EMAIL_VERIFICATION_REQUIRED=true
# Buat kunci dengan openssl rand -hex 32.
AUTH_OTP_HMAC_KEY=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_TLS_MODE=starttls
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
